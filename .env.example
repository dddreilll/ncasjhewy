# Comma-separated store codes seeded at boot (optional — the fleet can also be
# grown at runtime via the dashboard/API; those are persisted to data/fleet.json).
#  - one code  -> behaves like a single real store edge (production shape)
#  - many codes -> fleet simulator: N virtual stores in one process
STORE_CODES=S001,S002,S003

# Fleet dashboard + API port (http://localhost:4000)
PORT=4000

# RabbitMQ connection. Either a full URL...
# RABBITMQ_URL=amqp://admin:admin123@localhost:5674
# ...or discrete parts (same convention as fusion-cdh-api .env):
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5674

# Broker topology (defaults match fusion-cdh-api)
RABBITMQ_SYNC_EXCHANGE=cdh.datasync
RABBITMQ_SYNC_DLX=cdh.datasync.dlx
RABBITMQ_SYNC_PREFETCH=10

# Where per-store state + applied datasets are written (JSON files)
DATA_DIR=./data

# Optional: lets the dashboard trigger syncs directly at app-gateway (POST
# /store-data-sync/<dataset>, incl. preview/isTest) instead of needing Swagger
# open separately. Leave GATEWAY_ADMIN_BASE_URL unset to disable — the trigger
# panel then just doesn't appear. Must be a real, verified CDH user; sign-in
# goes through the same /auth/sign-in any user goes through.
GATEWAY_ADMIN_BASE_URL=http://localhost:1000
GATEWAY_ADMIN_USERNAME=
GATEWAY_ADMIN_PASSWORD=
GATEWAY_ADMIN_DEVICE_NAME=fusion-cdh-store-consumer
