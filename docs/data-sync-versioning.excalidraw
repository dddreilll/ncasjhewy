    {
      "type": "text", "id": "code_lbl",
      "x": 720, "y": 446, "width": 405, "height": 16,
      "text": "EDGE APPLY  —  version guard (idempotent)", "originalText": "EDGE APPLY  —  version guard (idempotent)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 105023,
