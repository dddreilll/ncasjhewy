    },
    {
      "type": "rectangle", "id": "code_rect",
      "x": 720, "y": 466, "width": 405, "height": 182,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 105025,
      "version": 1, "versionNonce": 105026, "isDeleted": false,
      "groupIds": [], "boundElements": [{"id": "code_t", "type": "text"}],
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "code_t",
      "x": 734, "y": 478, "width": 380, "height": 158,
      "text": "on message(env):\n  if env.version <= applied[env.type]:\n    ack()                    # already applied\n  elif env.mode == 'SNAPSHOT':\n    apply(env.payload)\n    applied = env.version;  ack()\n  elif env.previousVersion == applied:\n    applyDelta(env)\n    applied = env.version;  ack()\n  else:                        # gap!\n    reconcile();  nack(requeue=false)",
      "originalText": "on message(env):\n  if env.version <= applied[env.type]:\n    ack()                    # already applied\n  elif env.mode == 'SNAPSHOT':\n    apply(env.payload)\n    applied = env.version;  ack()\n  elif env.previousVersion == applied:\n    applyDelta(env)\n    applied = env.version;  ack()\n  else:                        # gap!\n    reconcile();  nack(requeue=false)",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 105027,
      "version": 1, "versionNonce": 105028, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "code_rect", "lineHeight": 1.3
    },
